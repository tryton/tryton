<form col="6">
    <label name="name"/>
    <field name="name"/>
    <label name="code"/>
    <field name="code"/>
    <label name="active"/>
    <field name="active" xexpand="0" width="100"/>
    <label name="phantom"/>
    <field name="phantom"/>
    <label name="phantom_quantity"/>
    <field name="phantom_quantity"/>
    <label name="phantom_unit"/>
    <field name="phantom_unit"/>

    <label name="tolerance"/>
    <group col="-1" id="tolerance">
        <field name="tolerance" factor="100" xexpand="0"/>
        <label name="tolerance" string="%" xexpand="1" xalign="0"/>
    </group>

    <notebook colspan="6">
        <page string="Lines" id="lines" col="2">
            <field name="inputs"/>
            <field name="outputs"/>
        </page>
    </notebook>
</form>
