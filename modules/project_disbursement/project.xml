this repository contains the full copyright notices and license terms. -->
<tryton>
    <data>
        <record model="res.group" id="group_project_disbursement">
            <field name="name">Project Disbursement</field>
        </record>

        <record model="ir.ui.view" id="project_configuration_view_form">
            <field name="model">project.configuration</field>
            <field name="inherit" ref="project.project_configuration_view_form"/>
            <field name="name">project_configuration_form</field>
        </record>

        <record model="ir.sequence.type" id="sequence_type_disbursement">
            <field name="name">Project Disbursement</field>
        </record>
        <record model="ir.sequence.type-res.group" id="sequence_type_disbursement_group_project_admin">
            <field name="sequence_type" ref="sequence_type_disbursement"/>
            <field name="group" ref="project.group_project_admin"/>
        </record>

        <record model="ir.ui.view" id="project_work_view_form">
            <field name="model">project.work</field>
            <field name="inherit" ref="project.work_view_form"/>
            <field name="name">project_work_form</field>
        </record>

        <record model="ir.ui.view" id="project_disbursement_view_form">
            <field name="model">project.disbursement</field>
            <field name="type">form</field>
            <field name="name">project_disbursement_form</field>
        </record>

        <record model="ir.ui.view" id="project_disbursement_view_list">
            <field name="model">project.disbursement</field>
            <field name="type">tree</field>
            <field name="name">project_disbursement_list</field>
        </record>

        <record model="ir.action.act_window" id="act_project_disbursement_form">
            <field name="name">Disbursements</field>
            <field name="res_model">project.disbursement</field>
        </record>
        <record model="ir.action.act_window.view" id="act_project_disbursement_form_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="project_disbursement_view_list"/>
            <field name="act_window" ref="act_project_disbursement_form"/>
        </record>
        <record model="ir.action.act_window.view" id="act_project_disbursement_form_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="project_disbursement_view_form"/>
            <field name="act_window" ref="act_project_disbursement_form"/>
        </record>
        <menuitem
            parent="project.menu_project"
            action="act_project_disbursement_form"
            sequence="30"
            id="menu_project_disbursement_form"/>

        <record model="ir.rule.group" id="rule_group_project_disbursement_companies">
            <field name="name">User in companies</field>
            <field name="model">project.disbursement</field>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_project_disbursement_companies">
            <field
                name="domain"
                eval="[('company', 'in', Eval('companies', []))]"
                pyson="1"/>
            <field name="rule_group" ref="rule_group_project_disbursement_companies"/>
        </record>

        <record model="ir.model.access" id="access_project_disbursement">
            <field name="model">project.disbursement</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_project_disbursement_disbursement">
            <field name="model">project.disbursement</field>
            <field name="group" ref="group_project_disbursement"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>

        <record model="ir.model.button" id="project_disbursement_draft_button">
            <field name="model">project.disbursement</field>
            <field name="name">draft</field>
            <field name="string">Draft</field>
        </record>

        <record model="ir.model.button" id="project_disbursement_validate_button">
            <field name="model">project.disbursement</field>
            <field name="name">validate_disbursement</field>
            <field name="string">Validate</field>
        </record>

        <record model="ir.model.button" id="project_disbursement_process_button">
            <field name="model">project.disbursement</field>
            <field name="name">process</field>
            <field name="string">Process</field>
        </record>

        <record model="ir.model.button" id="project_disbursement_cancel_button">
            <field name="model">project.disbursement</field>
            <field name="name">cancel</field>
            <field name="string">Cancel</field>
        </record>

        <record model="ir.ui.view" id="project_disbursement_journal_view_form">
            <field name="model">project.disbursement.journal</field>
            <field name="type">form</field>
            <field name="name">project_disbursement_journal_form</field>
        </record>

        <record model="ir.ui.view" id="project_disbursement_journal_view_list">
            <field name="model">project.disbursement.journal</field>
            <field name="type">tree</field>
            <field name="priority" eval="10"/>
            <field name="name">project_disbursement_journal_list</field>
        </record>

        <record model="ir.ui.view" id="project_disbursement_journal_view_list_sequence">
            <field name="model">project.disbursement.journal</field>
            <field name="type">tree</field>
            <field name="priority" eval="20"/>
            <field name="name">project_disbursement_journal_list_sequence</field>
        </record>
    </data>
    <data noupdate="1">
        <record model="ir.sequence" id="sequence_disbursement">
            <field name="name">Disbursement</field>
            <field name="sequence_type" ref="sequence_type_disbursement"/>
        </record>

        <record model="project.configuration.sequence" id="project.project_configuration_sequence">
            <field name="disbursement_sequence" ref="sequence_disbursement"/>
        </record>
    </data>
</tryton>
