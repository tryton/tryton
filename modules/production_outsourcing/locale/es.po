#, python-format
msgctxt "model:ir.message,text:msg_pending_purchase_cancel"
msgid ""
"The production \"%(productions)s\" cannot be cancelled as it has pending "
"purchases."
msgid_plural ""
"The productions \"%(productions)s\" cannot be cancelled as they have pending"
" purchases."
msgstr[0] ""
"La producción \"%(productions)s\" no se puede cancelar porqué tiene compras "
"pendientes."
msgstr[1] ""
"Las producciones \"%(productions)s\" no se pueden cancelar porqué tienen "
"compras pendientes."

#, python-format
msgctxt "model:ir.message,text:msg_pending_purchase_done"
msgid ""
"The production \"%(productions)s\" cannot be processed as it has pending "
"purchases."
msgid_plural ""
"The productions \"%(productions)s\" cannot be processed as they have pending"
" purchases."
msgstr[0] ""
"Laproducción \"%(productions)s\" no se puede procesar porqué tiene compras "
"pendientes."
msgstr[1] ""
"Las producciones \"%(productions)s\" no se pueden procesar porqué tienen "
"compras pendientes."

#, python-format
msgctxt "model:ir.message,text:msg_pending_purchase_draft"
msgid ""
"The production \"%(productions)s\" cannot be reset to draft as it has "
"pending purchases."
msgid_plural ""
"The productions \"%(productions)s\" cannot be reset to draft as they have "
"pending purchases."
msgstr[0] ""
