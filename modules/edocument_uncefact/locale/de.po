msgid ""
msgstr "Content-Type: text/plain; charset=utf-8\n"

msgctxt "model:edocument.uncefact.invoice,string:"
msgid "Edocument Uncefact Invoice"
msgstr "E-Dokument UN/CEFACT Rechnung"

#, python-format
msgctxt "model:ir.message,text:msg_bank_account_not_found"
msgid "Could not find bank account \"%(account)s\" for party \"%(parties)s\"."
msgid_plural ""
"Could not find bank account \"%(account)s\" for any of the parties "
"\"%(parties)s\"."
msgstr[0] ""
"Das Bankkonto \"%(account)s\" für die Partei \"%(parties)s\" konnte nicht "
"gefunden werden."
msgstr[1] ""
"Das Bankkonto \"%(account)s\" für die Parteien \"%(parties)s\" konnte nicht "
"gefunden werden."

#, python-format
msgctxt "model:ir.message,text:msg_company_not_found"
msgid ""
"Could not find the company for:\n"
"%(company)s"
msgstr ""
"Unternehmen nicht gefunden für:\n"
"%(company)s"

#, python-format
msgctxt "model:ir.message,text:msg_currency_not_found"
msgid "Could not find a currency with code \"%(code)s\"."
msgstr "Die Währung mit dem Code %(code)s konnte nicht gefunden werden."

#, python-format
msgctxt "model:ir.message,text:msg_invoice_type_code_unsupported"
msgid "Unsupported invoice type code \"%(type_code)s\"."
msgstr "Der Rechnungstyp %(type_code)s wird nicht unterstützt."

#, python-format
msgctxt "model:ir.message,text:msg_tax_not_found"
msgid ""
"Could not find tax for:\n"
"%(tax_category)s"
msgstr ""
"Keine Steuer gefunden für:\n"
"%(tax_category)s"

#, python-format
msgctxt "model:ir.message,text:msg_unit_not_found"
msgid ""
"Could not find a unit with UNECE code \"%(code)s\" and at least %(digits)s "
"digit."
msgid_plural ""
"Could not find a unit with UNECE code \"%(code)s\" and at least %(digits)s "
"digits."
msgstr[0] ""
"Es konnte keine Einheit mit dem UNECE-Code \"%(code)s\" und mindestens "
"%(digits)s Nachkommastellen gefunden werden."
msgstr[1] ""
"Es konnten keine Einheiten mit dem UNECE-Code \"%(code)s\" und mindestens "
"%(digits)s Nachkommastellen gefunden werden."

msgctxt "selection:account.invoice.edocument.start,format:"
msgid "UN/CEFACT"
msgstr "UN/CEFACT"
