this repository contains the full copyright notices and license terms. -->
<tryton>
    <data>
        <record model="ir.ui.view" id="stock_configuration_view_form">
            <field name="model">stock.configuration</field>
            <field name="inherit" ref="stock.stock_configuration_view_form"/>
            <field name="name">stock_configuration_form</field>
        </record>

        <record model="ir.sequence.type" id="sequence_type_conversion">
            <field name="name">Stock Conversion</field>
        </record>
        <record model="ir.sequence.type-res.group" id="sequence_type_conversion_group_stock_admin">
            <field name="sequence_type" ref="sequence_type_conversion"/>
            <field name="group" ref="stock.group_stock_admin"/>
        </record>

        <record model="ir.ui.view" id="stock_location_view_form">
            <field name="model">stock.location</field>
            <field name="inherit" ref="stock.location_view_form"/>
            <field name="name">stock_location_form</field>
        </record>

        <record model="ir.ui.view" id="stock_conversion_rule_view_form">
            <field name="model">stock.conversion.rule</field>
            <field name="type">form</field>
            <field name="name">stock_conversion_rule_form</field>
        </record>

        <record model="ir.ui.view" id="stock_conversion_rule_view_list">
            <field name="model">stock.conversion.rule</field>
            <field name="type">tree</field>
            <field name="name">stock_conversion_rule_list</field>
        </record>

        <record model="ir.model.access" id="access_stock_conversion_rule">
            <field name="model">stock.conversion.rule</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>

        <record model="ir.model.access" id="access_stock_conversion_rule_admin">
            <field name="model">stock.conversion.rule</field>
            <field name="group" ref="stock.group_stock_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>

        <record model="ir.ui.view" id="stock_conversion_view_list">
            <field name="model">stock.conversion</field>
            <field name="type">tree</field>
            <field name="name">stock_conversion_list</field>
        </record>

        <record model="ir.ui.view" id="stock_conversion_view_form">
            <field name="model">stock.conversion</field>
            <field name="type">form</field>
            <field name="name">stock_conversion_form</field>
        </record>

        <record model="ir.action.act_window" id="act_conversion_list">
            <field name="name">Conversions</field>
            <field name="res_model">stock.conversion</field>
            <field name="search_value"></field>
        </record>
        <record model="ir.action.act_window.view" id="act_conversion_list_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="stock_conversion_view_list"/>
            <field name="act_window" ref="act_conversion_list"/>
        </record>
        <record model="ir.action.act_window.view" id="act_conversion_list_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="stock_conversion_view_form"/>
            <field name="act_window" ref="act_conversion_list"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_conversion_list_domain_draft">
            <field name="name">Draft</field>
            <field name="sequence" eval="10"/>
            <field name="domain" eval="[('state', '=', 'draft')]" pyson="1"/>
            <field name="count" eval="True"/>
            <field name="act_window" ref="act_conversion_list"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_conversion_list_domain_all">
            <field name="name">All</field>
            <field name="sequence" eval="9999"/>
            <field name="domain"></field>
            <field name="act_window" ref="act_conversion_list"/>
        </record>
        <menuitem
            parent="stock.menu_stock"
            action="act_conversion_list"
            sequence="20"
            id="menu_conversion_list"/>

        <record model="ir.rule.group" id="rule_group_stock_conversion_companies">
            <field name="name">User in companies</field>
            <field name="model">stock.conversion</field>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_stock_conversion_companies">
            <field
                name="domain"
                eval="[('company', 'in', Eval('companies', []))]"
                pyson="1"/>
            <field name="rule_group" ref="rule_group_stock_conversion_companies"/>
        </record>

        <record model="ir.model.access" id="access_stock_conversion">
            <field name="model">stock.conversion</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_stock_conversion_group_stock_admin">
            <field name="model">stock.conversion</field>
            <field name="group" ref="stock.group_stock_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>

        <record model="ir.model.button" id="stock_conversion_cancel_button">
            <field name="model">stock.conversion</field>
            <field name="name">cancel</field>
            <field name="string">Cancel</field>
            <field name="confirm">Are your sur you want to cancel the conversion?</field>
        </record>

        <record model="ir.model.button" id="stock_conversion_wait_button">
            <field name="model">stock.conversion</field>
            <field name="name">do</field>
            <field name="string">Do</field>
        </record>
    </data>
    <data noupdate="1">
        <record model="ir.sequence" id="sequence_conversion">
            <field name="name">Stock Conversion</field>
            <field name="sequence_type" ref="sequence_type_conversion"/>
        </record>

        <record model="stock.location" id="stock_location_conversion">
            <field name="name">Conversion</field>
            <field name="code">CONV</field>
            <field name="type">production</field>
        </record>
        <record model="stock.location" id="stock.location_warehouse">
            <field name="conversion_location" ref="stock_location_conversion"/>
        </record>

        <record model="ir.cron" id="cron_set_cost_from_moves">
            <field name="method">stock.conversion|set_cost_from_moves</field>
            <field name="interval_number" eval="1"/>
            <field name="interval_type">days</field>
        </record>
    </data>
</tryton>
