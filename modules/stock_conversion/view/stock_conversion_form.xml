<form cursor="location">
    <label name="date"/>
    <field name="date"/>
    <label name="number"/>
    <field name="number"/>

    <label name="warehouse"/>
    <field name="warehouse"/>
    <label name="location"/>
    <field name="location"/>

    <notebook>
        <page string="Conversion" id="conversion" col="6">
            <label name="input_quantity"/>
            <field name="input_quantity" symbol="input_unit"/>
            <label name="input_product"/>
            <field name="input_product"/>
            <newline/>

            <label name="output_quantity"/>
            <field name="output_quantity" symbol="output_unit"/>
            <label name="output_product"/>
            <field name="output_product"/>
            <newline/>
        </page>
        <page name="moves">
            <field name="moves" colspan="4"/>
        </page>
        <page string="Other Info" id="other">
            <label name="company"/>
            <field name="company"/>
            <label name="conversion_rule"/>
            <field name="conversion_rule"/>

            <label name="done_by"/>
            <field name="done_by"/>
        </page>
    </notebook>

    <label name="state"/>
    <field name="state"/>
    <group col="-1" colspan="2" id="buttons">
        <button name="cancel" icon="tryton-cancel"/>
        <button name="do" icon="tryton-forward"/>
    </group>
</form>
